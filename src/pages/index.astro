---
import PokemonCard from '../components/PokemonCard.astro'
import type { PokemonList } from '../interfaces/PokemonList.interfaces'
import Layout from '../layouts/Layout.astro'

const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=20');
const data = await resp.json() as PokemonList
---

<Layout title="Pokemon Static | Home" description="Welcome to the Pokemon Static site!">
	<h1 class="text-3xl">Home Pokemon</h1>
	<section
	aria-label="Listado Pokemons"
	class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 ">
		{data.results.map((pokemon) => (
			<PokemonCard name={pokemon.name} url={pokemon.url}  />
		))}
	</section>
</Layout>
