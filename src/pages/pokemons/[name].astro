---
import type { GetStaticPaths } from "astro";
import PokemonCard from '@components/PokemonCard.astro'
import Layout from '@layouts/Layout.astro'

interface Props {
  url: string;
}
export const getStaticPaths = (() => {
    const data = fetch('https://pokeapi.co/api/v2/pokemon?limit=151')
    .then(res => res.json())
    .then((data) => {
        return data.results.map((pokemon: { name: string; url: string }) => ({
            params: { name: pokemon.name },
            props: { url: pokemon.url }
        }))
    })
    return data
   
}) as GetStaticPaths;

const {url} = Astro.props
const { name } = Astro.params  as { name: string }
const id = url.split('/')[url.split('/').length - 2]
const audioUrl = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/${id}.ogg`
const imageUrl= `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`

---

<Layout title={`Pokemon: ${name}`} description={`Información sobre el pokemon ${name}`} image={imageUrl}>
    <section class="flex flex-col items-center justify-center">
        <PokemonCard name={name} url={url} isBig/>  
        <audio controls class="mt-4">
            <source src={audioUrl} type="audio/ogg"/>
        </audio>
        <a href="/" class=" mt-2 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Regresar</a>
    </section>
</Layout>