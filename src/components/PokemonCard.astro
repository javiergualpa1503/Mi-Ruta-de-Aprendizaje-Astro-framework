---
interface Props{
    name:string
    url:string
    isBig?:boolean
}

const {name, url , isBig=false  } = Astro.props

const urlParts = url.split('/');
const id = urlParts[urlParts.length - 2];  
---

<a
 href={`/pokemon/${id}`}
 class="m-4 p-4 bg-slate-700 rounded-lg  flex flex-col items-center justify-center">
<img 
transition:name=`{name} - ${id}`

src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`} alt={name} class:list={
    [
        `w-32 h-32`,
        {
            'w-60 h-60': isBig
        }
    ]
} />
<h2 class:list={
    [
        `text-2xl capitalize`
    ]
}
>{name}</h2>
</a>

